{
  "manifest_version": 3,
  "name": "Slide Editor",
  "version": "0.3.0",
  "description": "Visual editor for HTML presentations - works offline",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "file://*",
    "http://*",
    "https://*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["editor.bundle.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
